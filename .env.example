# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api
SHEET_NAME=Candidates

# ---------------------------------------------------------------------------
# Google Sheets access driver
#   apps_script      -> OAuth-free bridge (scripts/google-sheet.gs deployed as a
#                       web app with "Anyone" access). Recommended.
#   service_account  -> authenticates as the service account below; the sheet
#                       must be shared with it as an Editor.
# ---------------------------------------------------------------------------
GOOGLE_SHEET_DRIVER=apps_script
GOOGLE_SHEET_TIMEOUT_MS=15000
GOOGLE_APPS_SCRIPT_URL=

# ---------------------------------------------------------------------------
# Google Sheets target
# ---------------------------------------------------------------------------
GOOGLE_SPREADSHEET_ID=

# ---------------------------------------------------------------------------
# Google Service Account (only for GOOGLE_SHEET_DRIVER=service_account)
# Keep the key on ONE line; the \n escapes are converted automatically.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Outgoing mail (nodemailer)
#   MAIL_AUTH_TYPE=password -> SMTP password / Gmail App Password
#   MAIL_AUTH_TYPE=oauth2   -> reuses the GOOGLE_CLIENT_* vars below
# ---------------------------------------------------------------------------
MAIL_SERVICE=gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_AUTH_TYPE=password
MAIL_FROM=
MAIL_USER=
MAIL_PASSWORD=

# ---------------------------------------------------------------------------
# Google OAuth2 (only needed for MAIL_AUTH_TYPE=oauth2)
# Client must be published (not in "Testing" mode) or refresh tokens expire
# after 7 days.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Email sending
# ---------------------------------------------------------------------------
# Fallback for POST /campaign/send when ?dryRun is not supplied. Keep true until
# a real send has been reviewed via GET /campaign/preview.
SEND_DEFAULT_DRY_RUN=true
EMAIL_DELAY_MS=2000
EMAIL_MAX_RETRIES=2
STALE_PROCESSING_THRESHOLD_MINUTES=30

# ---------------------------------------------------------------------------
# Cron / scheduling
# ---------------------------------------------------------------------------
# CRON_ENABLED=false means no job is registered at all - the app will never
# wake up on its own. POST /api/scheduler/run still triggers one cycle.
CRON_ENABLED=false
# Local time of the daily run. Both fields are validated at boot: an
# out-of-range value or a bad time zone refuses to start rather than
# registering a schedule that would silently never fire.
CRON_HOUR=8
CRON_MINUTE=0
CRON_TIMEZONE=Asia/Kolkata
# Registry name of the job; only change it if you run two instances.
CRON_JOB_NAME=mailops-daily-campaign
# Upper bound per run, applied to initial emails and to follow-ups separately.
CRON_BATCH_LIMIT=50
